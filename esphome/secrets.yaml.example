# Copy this file to "secrets.yaml" (in the same folder as the ESPHome files)
# and replace the values. Never upload secrets.yaml to GitHub.
# If you already have a secrets.yaml for other devices, just add the missing keys.

wifi_ssid: "YOUR_NETWORK"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password of the fallback access point (turns on if Wi-Fi cannot connect)
ap_password: "at-least-8-characters"

# API encryption key: generate a new one (32 bytes, base64), e.g. from
# https://esphome.io/components/api/ or with: openssl rand -base64 32
api_encryption_key: "PASTE_YOUR_BASE64_KEY_HERE="
